# Copy this file to .env before running docker compose up

# LLM
LLM_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=researchmind
DB_USER=researchmind
DB_PASSWORD=change-this-password

# Authentication
# Use a long random secret in production
JWT_SECRET=change-this-to-a-long-random-secret-in-production-min-32-chars
